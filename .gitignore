# ── Data & Model files ──────────────────────────────────────────────────────
# These are large or sensitive local files — do NOT commit them to GitHub.
# Anyone cloning the repo should provide their own dataset and retrain the model.

paysim.csv              # 493 MB PaySim dataset — too large for GitHub
fraud_database.db       # SQLite database built from the dataset
fraud_model.joblib      # Trained Random Forest model (regenerated by running ML.py)

